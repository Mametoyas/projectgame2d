[sub_resource type="GDScript" id="GDScript_5jxje"]
script/source = "extends Area2D

@export var speed: float = 900.0
@export var life_time: float = 2.0
@export var damage: int = 10
@export var fly_anim: StringName = \"bullet\"      # ตอนพุ่ง
@export var hit_anim: StringName = \"_explode\"    # ตอนโดน

var dir: Vector2 = Vector2.RIGHT
var exploding: bool = false
var last_hit: Node = null

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var col: CollisionShape2D = $CollisionShape2D

func _ready() -> void:
	# ชั้นการวาด
	z_index = 300
	z_as_relative = false

	# เปิดชนกับศัตรูชั้น 1 และ 2
	monitoring = true
	monitorable = true
	collision_layer = 0
	collision_mask = 0
	set_collision_mask_value(1, true)
	set_collision_mask_value(2, true)

	# หมุนตามทิศยิง + เล่นอนิเมชันวิ่ง
	rotation = dir.angle()
	if sprite and sprite.sprite_frames and sprite.sprite_frames.has_animation(fly_anim):
		sprite.play(fly_anim)

	# รับทั้ง Area และ Body
	if not area_entered.is_connected(_on_area_entered):
		area_entered.connect(_on_area_entered)
	if not body_entered.is_connected(_on_body_entered):
		body_entered.connect(_on_body_entered)

	# อายุสูงสุด
	get_tree().create_timer(life_time).timeout.connect(queue_free)

func _physics_process(delta: float) -> void:
	if exploding:
		return
	global_position += dir * speed * delta

func _on_area_entered(a: Area2D) -> void:
	var p: Node = a.get_parent() if a.get_parent() != null else a
	_schedule_hit(p)

func _on_body_entered(b: Node) -> void:
	_schedule_hit(b)

# เลื่อนงาน “หลังเฟรม” เพื่อไม่ไปยุ่งตอนฟิสิกส์กำลัง flush
func _schedule_hit(p: Node) -> void:
	if exploding:
		return
	last_hit = p
	call_deferred(\"_do_hit\")

func _do_hit() -> void:
	if exploding:
		return
	exploding = true

	# หาเป้าให้ชัด : ถ้าโดน Area ของศัตรู ให้ชี้ไปที่พาเรนต์
	var tgt: Node = last_hit
	if tgt is Area2D and tgt.get_parent() != null:
		tgt = tgt.get_parent()
	if tgt != null and tgt.is_in_group(\"enemies\") and tgt.has_method(\"apply_damage\"):
		tgt.call(\"apply_damage\", damage)

	# ปิดชนแบบ deferred ให้ปลอดภัย
	if col != null:
		col.set_deferred(\"disabled\", true)
	set_deferred(\"monitoring\", false)
	set_deferred(\"monitorable\", false)

	# เล่นเอฟเฟกต์ระเบิดแล้วค่อยลบ
	if sprite and sprite.sprite_frames and sprite.sprite_frames.has_animation(hit_anim):
		sprite.play(hit_anim)
		await sprite.animation_finished
	queue_free()
"

